# Copy to .env. Docker Compose reads it automatically.

# Set to TRUE only after you read and accept https://aka.ms/MinecraftEULA
ACCEPT_MINECRAFT_EULA=FALSE

# jev = Jev picks every action. heuristic = scripted policy, no API key needed.
POLICY=jev

# typesafe (https://console.typesafe.ai/keys) or openrouter.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Below this Jev confidence, the bot uses the scripted pick instead.
JEV_MIN_CONFIDENCE=0.2

DIFFICULTY=easy
WORLD_SEED=jev-diamonds
MAX_STEPS=3000
